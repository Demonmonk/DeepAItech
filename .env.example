# Deep AI Tech — environment variables
# Copy to `.env.local` for local dev, or set these in your host (e.g. Vercel
# → Project Settings → Environment Variables). Never commit real secrets.

# --- AI chat assistant (app/api/chat) ---------------------------------------
# Anthropic API key. Without it, the chat widget stays up but politely says
# it isn't connected yet. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model used by the assistant. Defaults to the cheapest current-gen
# model (Claude Haiku). For absolute lowest cost you can use an older Haiku,
# e.g. claude-3-haiku-20240307
# CHAT_MODEL=claude-haiku-4-5
